{
  "name": "english-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/vercel-build.js",
    "cloud-run:deploy": "bash scripts/cloud-run-deploy.sh",
    "cloud-run:deploy:win": "powershell -ExecutionPolicy Bypass -File scripts/cloud-run-deploy.ps1",
    "cloud-run:build": "docker build --platform linux/amd64 -t english-platform .",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "architecture:verify": "npx tsc --noEmit && npm run lint && npx vitest run && npx vitest run src/modules/__tests__/architecture.test.ts",
    "smoke": "node scripts/smoke-test.js",
    "check:i18n": "node scripts/check-i18n.js",
    "evaluate": "npx tsx scripts/evaluate-regression.ts",
    "evaluate:reading": "npx tsx scripts/evaluate-regression.ts --filter reading",
    "evaluate:update-golden": "npx tsx scripts/evaluate-regression.ts --update-golden",
    "calibration:ingest": "npx tsx scripts/ingest-calibration.ts",
    "calibration:ingest:human-marker": "npx tsx scripts/ingest-human-marker.ts",
    "calibration:report": "npx tsx scripts/calibration.ts",
    "calibration:intake": "npx tsx scripts/evidence-intake.ts",
    "calibration:verify": "npx tsx scripts/evidence-verify.ts",
    "calibration:marker-pack": "npx tsx scripts/marker-pack.ts",
    "calibration:marker-intake": "npx tsx scripts/marker-intake.ts",
    "calibration:adjudicate": "npx tsx scripts/adjudication-intake.ts",
    "calibration:freeze": "npx tsx scripts/freeze.ts",
    "prompt:list": "npx tsx scripts/prompt-version.ts list",
    "prompt:history": "npx tsx scripts/prompt-version.ts history",
    "prompt:diff": "npx tsx scripts/prompt-version.ts diff",
    "prompt:snapshot": "npx tsx scripts/prompt-version.ts snapshot",
    "prompt:changelog": "npx tsx scripts/prompt-version.ts changelog",
    "prompt:release": "npx tsx scripts/prompt-version.ts release",
    "prompt:states": "npx tsx scripts/prompt-version.ts states",
    "prompt:experiment": "npx tsx scripts/experiment.ts",
    "prompt:experiment:list": "npx tsx scripts/experiment.ts list",
    "prompt:experiment:run": "npx tsx scripts/experiment.ts run",
    "prompt:experiment:report": "npx tsx scripts/experiment.ts report",
    "prompt:experiment:compare": "npx tsx scripts/experiment.ts compare",
    "prompt:experiment:trend": "npx tsx scripts/experiment.ts trend",
    "prompt:experiment:history": "npx tsx scripts/experiment.ts history",
    "prompt:experiment:analyze": "npx tsx scripts/experiment.ts analyze",
    "prompt:monitor": "npx tsx scripts/monitor.ts",
    "prompt:monitor:daily": "npx tsx scripts/monitor.ts daily",
    "prompt:monitor:report": "npx tsx scripts/monitor.ts report",
    "prompt:monitor:dashboard": "npx tsx scripts/monitor.ts dashboard",
    "prompt:monitor:baseline": "npx tsx scripts/monitor.ts baseline",
    "prompt:monitor:alerts": "npx tsx scripts/monitor.ts alerts",
    "prompt:monitor:trend": "npx tsx scripts/monitor.ts trend",
    "prompt:monitor:providers": "npx tsx scripts/monitor.ts providers",
    "validate:prompts": "tsx scripts/validate-prompts.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "analytics:sync": "npx tsx scripts/sync-learning-activity-metrics.ts",
    "postinstall": "npx --yes prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@google-cloud/aiplatform": "^6.8.1",
    "@google-cloud/text-to-speech": "^6.4.1",
    "@google-cloud/vision": "^5.3.7",
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/pdfkit": "^0.17.6",
    "@vercel/kv": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "docx": "^9.7.1",
    "google-auth-library": "^10.9.0",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.23.0",
    "mammoth": "^1.12.0",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
