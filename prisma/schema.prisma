// ============================================
// Prisma Schema — AI 英語學習平台
// 資料庫: SQLite (開發) → PostgreSQL (正式)
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// 一、使用者 (教師、學生、管理員)
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  nameZh        String?
  nameEn        String?
  role          String    @default("student") // "student" | "teacher" | "admin"
  avatar        String?
  streakDays    Int       @default(0)
  joinedAt      DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // === 學生專屬欄位 ===
  classId       String?
  class         Class?    @relation(fields: [classId], references: [id])
  classNumber   String?   // 班號 (e.g. "15")
  level         String?   // GradeLevel: S1-S6
  // 2026-09-21 稽核：**不得**有 @default(0)。舊預設令每個新匯入學生在
  // 「尚未有任何可驗證證據」時即為 0%，被教師名單當成「答錯全部」，
  // 並把班平均／全校平均拉低（`syncActivityMetrics` 只寫 null 或真實值）。
  overallAccuracy Float?
  academicYear  String?   // 學年追蹤 (e.g. "2026-2027")
  xp            Int       @default(0)
  badgeIds      String    @default("[]")  // JSON 陣列: ["streak-3", "accuracy-80"]

  // === 教師專屬欄位 ===
  subjects      String?     // JSON 陣列: '["English Language"]'
  department    String?   // 所屬部門
  taughtClasses TeacherClass[]

  // === 多班級關聯（混合上課支援）===
  studentClasses StudentClass[]
  groupMemberships GroupMember[]
  createdGroups   Group[]
  targetAssignments AssignmentStudent[]

  // === 關聯 ===
  assignments   Assignment[]
  mistakes      Mistake[]
  vocabItems    VocabItem[]
  writingDrafts WritingDraft[]
  integratedSkillsDraft IntegratedSkillsDraft?
  submissions   Submission[]
  reviews       Review[]
  notifications Notification[]
  sessions      PracticeSession[]
  spellingSessions  SpellingSession[]
  accounts      Account[]
  sessionsAuth  Session[]

  // === RAG 關聯 ===
  uploadedMaterials Material[]
  preferences     UserPreferences?
  feedbacks       Feedback[]

  @@index([classId])
}

// ============================================
// 一之五、用戶偏好設定（跨裝置同步）
// ============================================

model UserPreferences {
  userId               String    @id
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  language             String    @default("zh")    // "zh" | "en"
  darkMode             Boolean   @default(false)
  sidebarOpen          Boolean   @default(true)
  notifAssignment      Boolean   @default(true)
  notifSubmission      Boolean   @default(true)   // 學生提交作業後的通知
  notifFeedback        Boolean   @default(true)
  notifAchievement     Boolean   @default(true)
  notifSystem          Boolean   @default(true)
  updatedAt            DateTime  @updatedAt
}

// ============================================
// Feedback — 用戶回報（TTS、UI、內容問題）
// ============================================

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "tts", "ui", "content", "bug", "feature-request"
  payload   String   // JSON stringified payload
  createdAt DateTime @default(now())
}

// ============================================
// 二、班級 — 聯繫教師與學生
// ============================================

model Class {
  id            String    @id @default(cuid())
  name          String    @unique   // e.g. "4A", "5C"
  gradeLevel    String              // S1-S6
  academicYear  String    @default("2026-2027")
  createdAt     DateTime  @default(now())

  // 關聯
  students      User[]
  teachers      TeacherClass[]
  assignments   Assignment[]
  studentClasses StudentClass[]
}

// 教師 ↔ 班級 (多對多)
model TeacherClass {
  id        String   @id @default(cuid())
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  isFormTeacher Boolean @default(false) // 是否為班主任

  @@unique([teacherId, classId])
}

// 學生 ↔ 班級 (多對多 — 混合上課)
model StudentClass {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([studentId, classId])
}

// 自訂組別（教師可建立跨班級組別，如「補底組」、「拔尖組」）
model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdBy   String   // teacherId
  teacher     User     @relation(fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())

  members     GroupMember[]
  assignments AssignmentGroup[]
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([groupId, studentId])
}

// ============================================
// 三、學習任務 (Assignment)
// ============================================

model Assignment {
  id              String    @id @default(cuid())
  title           String
  description     String?
  className       String?
  classId         String?
  targetType      String    @default("class") // class | group | students
  gradeLevel      String
  strand          String    // CurriculumStrand
  grammarItem     String?
  languageSkill   String?
  difficulty      String    // DifficultyLevel
  questionCount   Int       @default(5)
  timeLimit       Int?      // 分鐘
  dueDate         DateTime?
  completionRate  Float     @default(0)
  createdBy       String    // teacherId
  teacher         User      @relation(fields: [createdBy], references: [id])
  class           Class?    @relation(fields: [classId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  questions       AssignmentQuestion[]
  submissions     Submission[]

  // 組別與個別學生指派
  targetGroups    AssignmentGroup[]
  targetStudents  AssignmentStudent[]
}

model AssignmentGroup {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  groupId      String
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, groupId])
}

model AssignmentStudent {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model AssignmentQuestion {
  id            String    @id @default(cuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  questionType  String    // mc, fill-blank, etc.
  prompt        String
  options       String?   // JSON for MC
  answer        String
  explanation   String?
  orderIndex    Int       @default(0)
}

// 學生提交
model Submission {
  id            String    @id @default(cuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId     String
  student       User      @relation(fields: [studentId], references: [id])
  answers       String    // JSON: { questionId: answer }（最新嘗試的兼容視圖）
  score         Float?
  aiFeedback    String?
  submittedAt   DateTime?
  gradedAt      DateTime?
  // R3.5 hardening: 教師整體覆核標記。標記後該提交不得投影為逐題
  // StudentAssessmentResult（不偽造逐題人類評分，不改寫既有證據）。
  humanReviewedAt DateTime?
  status        String    @default("pending") // pending | submitted | graded
  createdAt     DateTime  @default(now())

  // R3.5: 每次提交嘗試的獨立執行身份與逐題評分證據
  attempts      SubmissionAttempt[]

  // R3.10-K Step 6: one canonical Submission per (assignment, student).
  // Concurrent first submissions previously created duplicate rows that
  // double-counted trusted accuracy. DB-level guarantee.
  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([assignmentId])
}

// R3.5: 提交嘗試 — 每次提交一個獨立記錄，歷史嘗試永不覆寫
model SubmissionAttempt {
  id            String    @id @default(cuid())
  submissionId  String
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  attemptNumber Int       @default(1)
  clientSubmissionId String?
  score         Float?
  aiFeedback    String?
  submittedAt   DateTime?
  createdAt     DateTime  @default(now())

  answers       SubmissionAnswer[]

  @@unique([submissionId, attemptNumber])
  @@unique([submissionId, clientSubmissionId])
  @@index([submissionId])
}

// R3.5: 逐題評分證據（questionId = AssignmentQuestion.id，伺服器持有的正典身份）
model SubmissionAnswer {
  id               String   @id @default(cuid())
  attemptId        String
  attempt          SubmissionAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String   // AssignmentQuestion.id — canonical, server-owned
  response         String   // 學生答案
  result           String   // correct | incorrect（現行評分器僅產生這兩種）
  awardedScore     Float
  maxScore         Float
  countsTowardScore Boolean
  evaluator        String   // server | ai | human（僅用 frozen AssessmentEvaluator 值）
  scoringMethod    String
  createdAt        DateTime @default(now())

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

// ============================================
// 四、錯題記錄
// ============================================

model Mistake {
  id              String    @id @default(cuid())
  studentId       String
  student         User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId      String
  questionSummary String    @default("") // 題目摘要（來自 questionPrompt）
  studentAnswer   String
  correctAnswer   String
  mistakeType     String    // grammar | vocabulary | comprehension | careless | time-management | chinglish
  // 2026-09-14: skill identity — 錯題的可複習單位是「技能／題型」而非該條題目。
  // 由伺服器解析（ReadingQuestion.dseType / GrammarQuestion.grammarItem），
  // 客戶端自報值僅在無法解析時才採用，且必須通過白名單（見 mistake-skill-identity.ts）。
  languageSkill   String?   // listening | speaking | reading | writing
  grammarItem     String?   // GrammarQuestion.grammarItem（文法項目）
  questionType    String?   // 閱讀 dseType（inference / vocabulary_in_context …）或文法題型
  skillSource     String?   // canonical | client-claimed | unresolved
  aiExplanation   String?
  reviewed        Boolean   @default(false)
  inReviewList    Boolean   @default(false)
  nextReviewDate  DateTime? // SRS: 下次複習日期
  reviewInterval  Int       @default(0)  // SRS: 複習間隔天數
  easeFactor      Float     @default(2.5) // SRS: 簡化 EF
  lastReviewedAt  DateTime? // SRS: 上次複習時間
  createdAt       DateTime  @default(now())

  @@index([studentId])
  // R3.10-E.2 P0-2: 同一學生同一題目只保留一筆錯題（原子 upsert 基礎）
  @@unique([studentId, questionId])
}

// ============================================
// 五、詞彙庫
// ============================================

model VocabItem {
  id                String    @id @default(cuid())
  studentId         String
  student           User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  word              String
  partOfSpeech      String
  allPartOfSpeech   String?   // JSON 陣列: ["noun","verb","adjective"]
  meaningZh         String
  secondaryMeaningZh String?  // 次要中文意思
  exampleSentence   String?
  exampleZh         String?   // 例句中文翻譯
  synonyms          String?   // JSON 陣列: ["happy","joyful","content"]
  antonyms          String?   // JSON 陣列: ["sad","unhappy"]
  collocations      String?   // JSON 陣列: ["make a decision","take a risk"]
  familiarity       String    @default("new") // new | learning | familiar | mastered
  masteryLevel      Int       @default(0)    // 0-5 掌握度評級
  nextReviewDate    DateTime?
  reviewInterval    Int       @default(0)    // SRS: 複習間隔天數
  easeFactor        Float     @default(2.5)  // SRS: 簡化 EF
  lastReviewedAt    DateTime? // SRS: 上次複習時間
  createdAt         DateTime  @default(now())

  @@unique([word, studentId])  // 同一學生不能重複加入相同單字
}

// ============================================
// 六、寫作草稿
// ============================================

model WritingDraft {
  id               String    @id @default(cuid())
  studentId        String
  student          User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title            String
  prompt           String
  draft            String
  revisedVersion   String?
  revisions        String?   // JSON: [{ draft, revisedVersion, aiSuggestions, createdAt }] — version history
  aiSuggestions    String?   // JSON: full WritingAnalysis (scores + scoringVersion + rubric metadata).
                             // R3.10-K Phase 3: typed score columns (canonicalOverallScore,
                             // platformEstimatedLevel, content/language/organizationScore,
                             // cloTotalScore) are DEFERRED as documented tech debt — the
                             // JSON blob carries the canonical scoringVersion for every record.
  chinglishWarnings String?  // JSON
  teacherComment   String?
  status           String    @default("draft") // draft | revised | reviewed
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ============================================
// 六點五、Integrated Skills 草稿持久化
// ============================================

model IntegratedSkillsDraft {
  userId             String    @id
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentNotes       String    @default("")
  studentWriting     String    @default("")
  taskData           String?   // JSON: IntegratedTaskData
  stage              String    @default("config") // config | listening | writing | result
  activeStep         Int       @default(1)        // 1 | 2 | 3
  listeningCompleted Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// ============================================
// 七、教材 (Material) — RAG 核心
// ============================================

model Material {
  id          String    @id @default(cuid())
  title       String
  description String?
  type        String    // pdf | docx | image | ppt | video | audio | link | text
  fileUrl     String?
  content     String?   // 提取的文字內容（OCR/解析後）
  tags        String?   // JSON 陣列
  gradeLevel  String?
  strand      String?
  isSystem    Boolean   @default(false) // 系統參考教材（HKDSE past papers 等），不顯示在教材中心
  ocrStatus   String    @default("none") // none | processing | done | failed
  ragStatus   String    @default("none") // none | chunking | embedding | done
  fileSize    Int?
  uploadedBy  String
  uploader    User      @relation(fields: [uploadedBy], references: [id])
  createdAt   DateTime  @default(now())

  // === RAG 嵌入區塊 ===
  chunks      MaterialChunk[]
}

// 材料文字區塊（用於向量嵌入）
model MaterialChunk {
  id             String    @id @default(cuid())
  materialId     String
  material       Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  chunkIndex     Int
  content        String
  tokenCount     Int       @default(0)
  embedding      String?   // JSON 浮點陣列（向量）— legacy，逐步遷移至 embeddingVector
  embeddingVector Unsupported("vector(1536)")?  // pgvector 原生向量欄位
  createdAt      DateTime  @default(now())
}

// ============================================
// 八、練習記錄 (Practice Session)
// ============================================

model PracticeSession {
  id             String    @id @default(cuid())
  studentId      String
  student        User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill          String    // grammarItem or languageSkill
  skillZh        String
  difficulty     String
  totalQuestions Int
  correctCount   Int       @default(0)
  source         String    // ai-generated | mock | assignment
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  masteryAppliedAt DateTime?
  // R3.10-E.2 P0-3: 客戶端重播/去重鍵 — 僅作 idempotency，絕非權威信號。
  // null = 歷史/未帶鍵的請求（維持現有行為，不強制回溯）。
  clientSubmissionId String?

  answers        PracticeAnswer[]

  @@index([studentId])
  @@unique([studentId, clientSubmissionId])
}

// 逐題答案記錄
// R3.1: questionId = canonical PracticeQuestion.id (null for historical rows)
// R3.2: result/awardedScore/maxScore/countsTowardScore preserve actual runtime scoring
model PracticeAnswer {
  id             String    @id @default(cuid())
  sessionId      String
  session        PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionIndex  Int       // 題號 (0-based) — ordering only, NOT identity
  questionId     String?   // 題目識別 (PracticeQuestion.id / reading runtime id); null = historical row
  questionType   String    // mc | fill-blank | matching | ordering | short-answer
  questionPrompt String    // 題目文字
  correctAnswer  String    // 正確答案
  studentAnswer  String    // 學生答案
  isCorrect      Boolean
  result         String?   // correct | incorrect | partial | ungradable (new rows)
  awardedScore   Float?    // 實際得分 (new rows)
  maxScore       Float?    // 滿分 (new rows)
  countsTowardScore Boolean? @default(true) // 是否計入總分 (new rows)
  scoredBy       String?   // R3.3/R3.7: actual scoring authority — 'server' | 'ai' | 'client' (client = historical only)
  scoringMethod  String?   // R3.3: scoring method label (evidence-backed)
  timeSpent      Int?      // 作答秒數
  createdAt      DateTime  @default(now())

  @@index([sessionId])
  @@unique([sessionId, questionId])
}

// ============================================
// R3.7: 伺服器持有的正典閱讀題目定義（閱讀評分的唯一權威來源）
// 新產生題目在生成時即持久化；新持久化的閱讀 questionId 必須能解析到
// 此表。歷史 rd-* 題目不存在於此表 → NOT_PROJECTABLE（永不重建）。
// ============================================
model ReadingQuestion {
  id            String   @id @default(cuid())
  questionType  String   // 後端 camelCase 類型（mcq / trueFalseNG / shortAnswer ...）
  dseType       String?  // 前端 snake_case 類型（multiple_choice ...）
  questionText  String
  choices       String?  // JSON array（MC 選項）
  answer        String   // 正典答案鍵 — 伺服器持有
  marks         Float    @default(1)
  orderIndex    Int      @default(0)
  passageTitle  String?  // 資訊性欄位（可選）
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

// ============================================
// R3.10-D: 伺服器持有的正典文法題目定義
// 文法題目於生成時即持久化（provenance = ai-generated / human-reviewed）；
// 文法 PracticeAnswer.questionId 必須能解析到此表，否則 NOT_PROJECTABLE。
// 客戶端 correctAnswer/choices/questionPrompt 永不作為評分權威。
// ============================================
model GrammarQuestion {
  id              String    @id @default(cuid())
  questionType    String    // mc | fill-blank | error-correction | matching | cloze ...
  prompt          String
  promptZh        String?
  choices         String?   // JSON array（MC 選項）
  answer          String    // 正典答案鍵 — 伺服器持有
  acceptedAnswers String?   // JSON array（額外可接受答案）
  grammarItem     String?   // 文法項目（tenses-simple ...）
  languageSkill   String?   // 語言技能（保留欄位）
  difficulty      String
  gradeLevel      String
  explanationZh   String?
  explanationEn   String?
  provenance      String    @default("ai-generated") // ai-generated | human-reviewed
  validatedAt     DateTime? // 結構驗證通過時間
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([createdAt])
}

// ============================================
// 九、通知
// ============================================

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // assignment | feedback | reminder | system | achievement
  title     String
  message   String
  link      String?
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ============================================
// 十、教師覆核 (Review)
// ============================================

model Review {
  id              String    @id @default(cuid())
  submissionId    String?
  studentId       String
  student         User      @relation(fields: [studentId], references: [id])
  teacherId       String?
  questionPrompt  String
  studentAnswer   String
  correctAnswer   String?
  aiScore         Float?
  aiFeedback      String?
  teacherScore    Float?
  teacherFeedback String?
  status          String    @default("pending") // pending | reviewed
  createdAt       DateTime  @default(now())
}

// ============================================
// 十一、NextAuth.js 模型（Google OAuth）
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// 登入記錄
// ============================================

model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  userEmail String
  userName  String?
  role      String
  ipAddress String?
  userAgent String?
  loginAt   DateTime @default(now())
  duration  Int?     // 登入時長（分鐘），登出時更新

  @@index([userId])
  @@index([loginAt])
}

// ============================================
// 每週進度快照
// ============================================

model WeeklySnapshot {
  id            String   @id @default(cuid())
  userId        String
  weekStart     String   // e.g. "2026-07-07" (Monday)
  totalQuestions Int     @default(0)
  correctCount  Int      @default(0)
  accuracy      Float    @default(0)
  sessionsCount Int      @default(0)
  xpGained      Int      @default(0)
  streakDays    Int      @default(0)
  wordsLearned  Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([userId, weekStart])
  @@index([userId])
}

// ============================================
// 診斷測驗結果
// ============================================

model DiagnosticResult {
  id            String   @id @default(cuid())
  studentId     String
  skill         String   // grammar | reading | writing | listening | integrated
  skillZh       String
  accuracy      Float    @default(0)
  weakAreas     String   // JSON: ["conditionals", "relative clauses"]
  recommendedGrammar String?  // 建議練習的文法項目
  recommendedSkill    String?  // 建議練習的語言技能
  completedAt   DateTime @default(now())

  @@index([studentId])
  @@index([completedAt])
}

// ============================================
// 十二、XP 交易記錄
// ============================================

model XpTransaction {
  id        String   @id @default(cuid())
  userId    String
  event     String   // answerCorrect | answerIncorrect | completeSession | completeDiagnostic | completeSpelling | submitWriting | dailyLogin | reviewMistake | learnWord | masterWord（'streakBonus'/'achievementBonus' 僅為 2026-09-28 前的歷史值）
  xpAmount  Int
  idempotencyKey String? @unique
  metadata  String?  // JSON: { sessionId, questionIndex, wordId, badgeId, ... }
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ============================================
// 十三、詞彙掌握度變更記錄
// ============================================

model VocabMasteryLog {
  id             String   @id @default(cuid())
  vocabId        String
  studentId      String
  fromLevel      String   // new | learning | familiar | mastered
  toLevel        String
  fromMastery    Int      // 0-5
  toMastery      Int
  changedAt      DateTime @default(now())

  @@index([vocabId])
  @@index([studentId])
}

// ============================================
// 十四、錯題複習記錄
// ============================================

model MistakeReviewLog {
  id         String   @id @default(cuid())
  mistakeId  String
  studentId  String
  action     String   // reviewed | addToReviewList | removeFromReviewList | srsReview
  outcome    String?  // correct | incorrect | skipped
  reviewedAt DateTime @default(now())

  @@index([mistakeId])
  @@index([studentId])
}

// ============================================
// 十五、伺服器持有的正典聆聽題目定義（2026-09-21 ADR-045）
// ============================================
// 聆聽練習／診斷的選擇題在**交付前**持久化於此，令伺服器握有答案鍵，
// 提交時可用自己的鍵評分（scoringMethod = listening-server-exact-match）
// → 計入準確率、技能掌握度與錯題本（與 ReadingQuestion 同一契約）。
//
// 只收「答案在對話中逐字出現」的客觀選擇題；需要語意判斷的題型
// （筆記、填空、自由作答）不持久化，維持自評。
//
// 註：舊的休眠表 ListeningSession / ListeningAnswer 已於 2026-09-21 刪除
// （生產實測 0 列，且唯一寫入函式全專案零呼叫者）。
model ListeningQuestion {
  id            String   @id @default(cuid())
  questionType  String   // mc | fill-blank
  listeningType String?  // detail | gist | inference（供錯題技能聚合）
  questionText  String
  choices       String?  // JSON array（MC 選項）
  answer        String   // 正典答案鍵 — 伺服器持有
  marks         Float    @default(1)
  orderIndex    Int      @default(0)
  dialogue      String?  // 該題專屬對話（供重播／錯題重溫／審計）
  dialogueZh    String?
  provenance    String   @default("ai-generated")
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

// ============================================
// 十六、串字練習記錄 (Spelling Practice)
// ============================================

model SpellingSession {
  id             String    @id @default(cuid())
  studentId      String
  student        User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  totalWords     Int
  correctCount   Int       @default(0)
  status         String    @default("in-progress") // in-progress | completed
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  attempts       SpellingAttempt[]

  @@index([studentId])
}

model SpellingAttempt {
  id             String    @id @default(cuid())
  sessionId      String
  session        SpellingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  vocabId        String?
  word           String
  meaningZh      String
  explanationEn  String?   // 英文解釋提示
  studentInput   String    // 學生輸入
  isCorrect      Boolean
  attempts       Int       @default(1)  // 第幾次嘗試
  createdAt      DateTime  @default(now())

  @@index([sessionId])
  @@index([vocabId])
}

// ============================================
// Sprint 25: Learning Memory — persistent student context
// ============================================

model LearningMemory {
  studentId  String   @id
  memoryJson String   @default("{}")
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============================================
// Sprint 33: Learning Science Engine — review schedule persistence
// ============================================

model LearningReviewSchedule {
  id              String   @id @default(cuid())
  studentId       String
  itemId          String   // nodeId from knowledge graph, vocabId, or mistakeId
  itemType        String   // "knowledge-node" | "vocabulary" | "mistake" | "grammar" | "skill"
  skillDimension  String?  // grammar, vocabulary, reading, writing, listening, speaking
  title           String?
  titleZh         String?

  // SM-2 state
  interval        Int      @default(0)    // days until next review
  easeFactor      Float    @default(2.5)  // SM-2 ease factor (min 1.3)
  repetitions     Int      @default(0)    // successful review count
  lapses          Int      @default(0)    // forgotten count
  quality         Int      @default(0)    // 0-5 SM-2 quality rating

  // Bayesian mastery estimation
  estimatedMastery     Float @default(0)  // 0-1 posterior mean
  masteryConfidence    Float @default(0)  // 0-1 certainty
  evidenceCount        Int   @default(0)  // number of data points
  isMastered           Boolean @default(false)

  // Difficulty tracking
  currentDifficulty    String @default("core") // remedial | core | challenge
  difficultyAdjustment String @default("maintain") // increase | decrease | maintain
  adaptiveFactor       Float  @default(1.0)

  // Retrieval practice
  retrievalStrength    Float  @default(0)  // 0-1
  timesCorrect         Int    @default(0)
  timesIncorrect       Int    @default(0)

  // Forgetting curve
  reviewStrength       Float  @default(1.0) // composite strength for Ebbinghaus
  retentionProbability Float  @default(1.0) // predicted retention R=e^(-t/S)

  // Reflection
  lastReflection       String? // ISO date of last reflection prompt
  reflectionNotes      String? // student's self-reflection

  // Scheduling
  lastReviewedAt       DateTime?
  nextReviewAt         DateTime @default(now())
  reviewPriority       Float    @default(0) // 0-1, higher = more urgent
  reviewUrgency        String   @default("low") // critical | high | medium | low

  // Recommendation integration
  recommendationReason      String?
  recommendationReasonZh    String?
  recommendedStrategy       String? // which RecommendationStrategy generated this

  // Metadata
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([studentId])
  @@index([studentId, nextReviewAt])
  @@index([studentId, itemType])
  @@unique([studentId, itemId])
}

// ============================================
// Sprint 31: Student Mastery Model — 學生掌握度模型
// ============================================

model StudentMastery {
  id              String   @id @default(cuid())
  studentId       String
  skill           String   // Grammar | Vocabulary | Reading | Writing | Listening | Speaking
  subSkill        String   // Articles | Tenses | Collocations | Inference | Organization etc.
  masteryScore    Int      @default(0)  // 0-100
  confidenceScore Int      @default(0)  // 0-100
  retentionScore  Int      @default(0)  // 0-100
  lastPracticedAt DateTime?
  practiceCount   Int      @default(0)
  mistakeCount    Int      @default(0)
  correctCount    Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@unique([studentId, skill, subSkill])
  @@index([studentId])
  @@index([studentId, skill])
}

// ============================================
// Sprint 32: Student Mistake Summary — 錯題智能摘要
// ============================================

model StudentMistakeSummary {
  id              String   @id @default(cuid())
  studentId       String
  grammarCategory String   // tense | article | preposition | passive-voice | etc.
  mistakeCount    Int      @default(0)
  lastSeen        DateTime @default(now())
  severity        String   // critical | major | minor
  mastered        Boolean  @default(false)
  trend           String   // improving | stable | worsening
  updatedAt       DateTime @updatedAt

  @@unique([studentId, grammarCategory])
  @@index([studentId])
}

// ============================================
// Sprint 126: DiagnosticStats — 同年級平均分對照
// ============================================

model DiagnosticStats {
  id         String   @id @default(cuid())
  gradeLevel String   // S1, S2, S3, S4, S5, S6
  skill      String   // grammar, vocabulary, reading, listening, writing
  totalScore Int      @default(0) // cumulative percentage scores
  totalCount Int      @default(0) // number of submissions
  updatedAt  DateTime @updatedAt

  @@unique([gradeLevel, skill])
}

// R3.10-L: per-student diagnostic contribution tracking — the aggregate
// DiagnosticStats only counts each student's LATEST score per skill, so
// repeated submissions cannot inflate the peer average.
model DiagnosticStudentStat {
  id         String   @id @default(cuid())
  gradeLevel String   // S1, S2, S3, S4, S5, S6
  skill      String   // grammar, vocabulary, reading, listening, writing
  studentId  String
  lastScore  Int      // latest percentage score contributed to the aggregate
  updatedAt  DateTime @updatedAt

  @@unique([gradeLevel, skill, studentId])
}

// ============================================
// 2026-09-18: AiDailyUsage — global daily AI usage ledger
//
// Backs the LLM budget gate in ai/runtime/budget-policy.ts. The counter used
// to live only in process memory, but Cloud Run runs minScale 0 / maxScale 20,
// so each instance tracked its own total: on the same day one instance could
// report "exhausted" (503 for every AI call) while a sibling instance was still
// fresh, and any cold start silently reset the "daily" cap.
//
// One row per UTC calendar day, shared by every instance.
// ============================================
model AiDailyUsage {
  dayKey    String   @id // 'YYYY-MM-DD' (UTC)
  tokens    Int      @default(0) // estimated tokens consumed (1 token ≈ 4 chars)
  costUsd   Float    @default(0) // estimated USD — budget accounting only, never billing
  updatedAt DateTime @updatedAt
}
