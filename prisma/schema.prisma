// ============================================
// Prisma Schema — AI 英語學習平台
// 資料庫: SQLite (開發) → PostgreSQL (正式)
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// 一、使用者 (教師、學生、管理員)
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  nameZh        String?
  nameEn        String?
  role          String    @default("student") // "student" | "teacher" | "admin"
  avatar        String?
  streakDays    Int       @default(0)
  joinedAt      DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // === 學生專屬欄位 ===
  classId       String?
  class         Class?    @relation(fields: [classId], references: [id])
  classNumber   String?   // 班號 (e.g. "15")
  level         String?   // GradeLevel: S1-S6
  overallAccuracy Float?  @default(0)
  academicYear  String?   // 學年追蹤 (e.g. "2025-2026")
  xp            Int       @default(0)
  badgeIds      String    @default("[]")  // JSON 陣列: ["streak-3", "accuracy-80"]

  // === 教師專屬欄位 ===
  subjects      String?   // JSON 陣列: '["English Language"]'
  department    String?   // 所屬部門
  taughtClasses TeacherClass[]

  // === 多班級關聯（混合上課支援）===
  studentClasses StudentClass[]
  groupMemberships GroupMember[]
  createdGroups   Group[]
  targetAssignments AssignmentStudent[]

  // === 關聯 ===
  assignments   Assignment[]
  mistakes      Mistake[]
  vocabItems    VocabItem[]
  writingDrafts WritingDraft[]
  integratedSkillsDraft IntegratedSkillsDraft?
  submissions   Submission[]
  reviews       Review[]
  notifications Notification[]
  sessions      PracticeSession[]
  listeningSessions ListeningSession[]
  spellingSessions  SpellingSession[]
  accounts      Account[]
  sessionsAuth  Session[]

  // === RAG 關聯 ===
  uploadedMaterials Material[]
  preferences     UserPreferences?

  @@index([classId])
}

// ============================================
// 一之五、用戶偏好設定（跨裝置同步）
// ============================================

model UserPreferences {
  userId               String    @id
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  language             String    @default("zh")    // "zh" | "en"
  darkMode             Boolean   @default(false)
  sidebarOpen          Boolean   @default(true)
  notifAssignment      Boolean   @default(true)
  notifSubmission      Boolean   @default(true)   // 學生提交作業後的通知
  notifFeedback        Boolean   @default(true)
  notifAchievement     Boolean   @default(true)
  notifSystem          Boolean   @default(true)
  updatedAt            DateTime  @updatedAt
}

// ============================================
// 二、班級 — 聯繫教師與學生
// ============================================

model Class {
  id            String    @id @default(cuid())
  name          String    @unique   // e.g. "4A", "5C"
  gradeLevel    String              // S1-S6
  academicYear  String    @default("2025-2026")
  createdAt     DateTime  @default(now())

  // 關聯
  students      User[]
  teachers      TeacherClass[]
  assignments   Assignment[]
  studentClasses StudentClass[]
}

// 教師 ↔ 班級 (多對多)
model TeacherClass {
  id        String   @id @default(cuid())
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  isFormTeacher Boolean @default(false) // 是否為班主任

  @@unique([teacherId, classId])
}

// 學生 ↔ 班級 (多對多 — 混合上課)
model StudentClass {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([studentId, classId])
}

// 自訂組別（教師可建立跨班級組別，如「補底組」、「拔尖組」）
model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdBy   String   // teacherId
  teacher     User     @relation(fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())

  members     GroupMember[]
  assignments AssignmentGroup[]
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([groupId, studentId])
}

// ============================================
// 三、學習任務 (Assignment)
// ============================================

model Assignment {
  id              String    @id @default(cuid())
  title           String
  description     String?
  className       String?
  classId         String?
  targetType      String    @default("class") // class | group | students
  gradeLevel      String
  strand          String    // CurriculumStrand
  grammarItem     String?
  languageSkill   String?
  difficulty      String    // DifficultyLevel
  questionCount   Int       @default(5)
  timeLimit       Int?      // 分鐘
  dueDate         DateTime?
  completionRate  Float     @default(0)
  createdBy       String    // teacherId
  teacher         User      @relation(fields: [createdBy], references: [id])
  class           Class?    @relation(fields: [classId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  questions       AssignmentQuestion[]
  submissions     Submission[]

  // 組別與個別學生指派
  targetGroups    AssignmentGroup[]
  targetStudents  AssignmentStudent[]
}

model AssignmentGroup {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  groupId      String
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, groupId])
}

model AssignmentStudent {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model AssignmentQuestion {
  id            String    @id @default(cuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  questionType  String    // mc, fill-blank, etc.
  prompt        String
  options       String?   // JSON for MC
  answer        String
  explanation   String?
  orderIndex    Int       @default(0)
}

// 學生提交
model Submission {
  id            String    @id @default(cuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId     String
  student       User      @relation(fields: [studentId], references: [id])
  answers       String    // JSON: { questionId: answer }
  score         Float?
  aiFeedback    String?
  submittedAt   DateTime?
  gradedAt      DateTime?
  status        String    @default("pending") // pending | submitted | graded
  createdAt     DateTime  @default(now())

  @@index([studentId])
  @@index([assignmentId])
}

// ============================================
// 四、錯題記錄
// ============================================

model Mistake {
  id              String    @id @default(cuid())
  studentId       String
  student         User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId      String
  questionSummary String    @default("") // 題目摘要（來自 questionPrompt）
  studentAnswer   String
  correctAnswer   String
  mistakeType     String    // grammar | vocabulary | comprehension | careless | time-management | chinglish
  aiExplanation   String?
  reviewed        Boolean   @default(false)
  inReviewList    Boolean   @default(false)
  nextReviewDate  DateTime? // SRS: 下次複習日期
  reviewInterval  Int       @default(0)  // SRS: 複習間隔天數
  easeFactor      Float     @default(2.5) // SRS: 簡化 EF
  lastReviewedAt  DateTime? // SRS: 上次複習時間
  createdAt       DateTime  @default(now())

  @@index([studentId])
}

// ============================================
// 五、詞彙庫
// ============================================

model VocabItem {
  id                String    @id @default(cuid())
  studentId         String
  student           User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  word              String
  partOfSpeech      String
  allPartOfSpeech   String?   // JSON 陣列: ["noun","verb","adjective"]
  meaningZh         String
  secondaryMeaningZh String?  // 次要中文意思
  exampleSentence   String?
  exampleZh         String?   // 例句中文翻譯
  synonyms          String?   // JSON 陣列: ["happy","joyful","content"]
  antonyms          String?   // JSON 陣列: ["sad","unhappy"]
  collocations      String?   // JSON 陣列: ["make a decision","take a risk"]
  familiarity       String    @default("new") // new | learning | familiar | mastered
  masteryLevel      Int       @default(0)    // 0-5 掌握度評級
  nextReviewDate    DateTime?
  reviewInterval    Int       @default(0)    // SRS: 複習間隔天數
  easeFactor        Float     @default(2.5)  // SRS: 簡化 EF
  lastReviewedAt    DateTime? // SRS: 上次複習時間
  createdAt         DateTime  @default(now())

  @@unique([word, studentId])  // 同一學生不能重複加入相同單字
}

// ============================================
// 六、寫作草稿
// ============================================

model WritingDraft {
  id               String    @id @default(cuid())
  studentId        String
  student          User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title            String
  prompt           String
  draft            String
  revisedVersion   String?
  revisions        String?   // JSON: [{ draft, revisedVersion, aiSuggestions, createdAt }] — version history
  aiSuggestions    String?   // JSON
  chinglishWarnings String?  // JSON
  teacherComment   String?
  status           String    @default("draft") // draft | revised | reviewed
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ============================================
// 六點五、Integrated Skills 草稿持久化
// ============================================

model IntegratedSkillsDraft {
  userId             String    @id
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentNotes       String    @default("")
  studentWriting     String    @default("")
  taskData           String?   // JSON: IntegratedTaskData
  stage              String    @default("config") // config | listening | writing | result
  activeStep         Int       @default(1)        // 1 | 2 | 3
  listeningCompleted Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// ============================================
// 七、教材 (Material) — RAG 核心
// ============================================

model Material {
  id          String    @id @default(cuid())
  title       String
  description String?
  type        String    // pdf | docx | image | ppt | video | audio | link | text
  fileUrl     String?
  content     String?   // 提取的文字內容（OCR/解析後）
  tags        String?   // JSON 陣列
  gradeLevel  String?
  strand      String?
  isSystem    Boolean   @default(false) // 系統參考教材（HKDSE past papers 等），不顯示在教材中心
  ocrStatus   String    @default("none") // none | processing | done | failed
  ragStatus   String    @default("none") // none | chunking | embedding | done
  fileSize    Int?
  uploadedBy  String
  uploader    User      @relation(fields: [uploadedBy], references: [id])
  createdAt   DateTime  @default(now())

  // === RAG 嵌入區塊 ===
  chunks      MaterialChunk[]
}

// 材料文字區塊（用於向量嵌入）
model MaterialChunk {
  id             String    @id @default(cuid())
  materialId     String
  material       Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  chunkIndex     Int
  content        String
  tokenCount     Int       @default(0)
  embedding      String?   // JSON 浮點陣列（向量）— legacy，逐步遷移至 embeddingVector
  embeddingVector Unsupported("vector(1536)")?  // pgvector 原生向量欄位
  createdAt      DateTime  @default(now())
}

// ============================================
// 八、練習記錄 (Practice Session)
// ============================================

model PracticeSession {
  id             String    @id @default(cuid())
  studentId      String
  student        User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill          String    // grammarItem or languageSkill
  skillZh        String
  difficulty     String
  totalQuestions Int
  correctCount   Int       @default(0)
  source         String    // ai-generated | mock | assignment
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  answers        PracticeAnswer[]

  @@index([studentId])
}

// 逐題答案記錄
model PracticeAnswer {
  id             String    @id @default(cuid())
  sessionId      String
  session        PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionIndex  Int       // 題號 (0-based)
  questionType   String    // mc | fill-blank | matching | ordering | short-answer
  questionPrompt String    // 題目文字
  correctAnswer  String    // 正確答案
  studentAnswer  String    // 學生答案
  isCorrect      Boolean
  timeSpent      Int?      // 作答秒數
  createdAt      DateTime  @default(now())

  @@index([sessionId])
}

// ============================================
// 九、通知
// ============================================

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // assignment | feedback | reminder | system | achievement
  title     String
  message   String
  link      String?
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ============================================
// 十、教師覆核 (Review)
// ============================================

model Review {
  id              String    @id @default(cuid())
  submissionId    String?
  studentId       String
  student         User      @relation(fields: [studentId], references: [id])
  teacherId       String?
  questionPrompt  String
  studentAnswer   String
  correctAnswer   String?
  aiScore         Float?
  aiFeedback      String?
  teacherScore    Float?
  teacherFeedback String?
  status          String    @default("pending") // pending | reviewed
  createdAt       DateTime  @default(now())
}

// ============================================
// 十一、NextAuth.js 模型（Google OAuth）
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// 登入記錄
// ============================================

model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  userEmail String
  userName  String?
  role      String
  ipAddress String?
  userAgent String?
  loginAt   DateTime @default(now())
  duration  Int?     // 登入時長（分鐘），登出時更新

  @@index([userId])
  @@index([loginAt])
}

// ============================================
// 每週進度快照
// ============================================

model WeeklySnapshot {
  id            String   @id @default(cuid())
  userId        String
  weekStart     String   // e.g. "2026-07-07" (Monday)
  totalQuestions Int     @default(0)
  correctCount  Int      @default(0)
  accuracy      Float    @default(0)
  sessionsCount Int      @default(0)
  xpGained      Int      @default(0)
  streakDays    Int      @default(0)
  wordsLearned  Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([userId, weekStart])
  @@index([userId])
}

// ============================================
// 診斷測驗結果
// ============================================

model DiagnosticResult {
  id            String   @id @default(cuid())
  studentId     String
  skill         String   // grammar | reading | writing | listening | integrated
  skillZh       String
  accuracy      Float    @default(0)
  weakAreas     String   // JSON: ["conditionals", "relative clauses"]
  recommendedGrammar String?  // 建議練習的文法項目
  recommendedSkill    String?  // 建議練習的語言技能
  completedAt   DateTime @default(now())

  @@index([studentId])
  @@index([completedAt])
}

// ============================================
// 十二、XP 交易記錄
// ============================================

model XpTransaction {
  id        String   @id @default(cuid())
  userId    String
  event     String   // dailyLogin | answerCorrect | completeSession | submitWriting | learnWord | masterWord | reviewMistake | streakBonus | achievementBonus
  xpAmount  Int
  metadata  String?  // JSON: { sessionId, questionIndex, wordId, badgeId, ... }
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ============================================
// 十三、詞彙掌握度變更記錄
// ============================================

model VocabMasteryLog {
  id             String   @id @default(cuid())
  vocabId        String
  studentId      String
  fromLevel      String   // new | learning | familiar | mastered
  toLevel        String
  fromMastery    Int      // 0-5
  toMastery      Int
  changedAt      DateTime @default(now())

  @@index([vocabId])
  @@index([studentId])
}

// ============================================
// 十四、錯題複習記錄
// ============================================

model MistakeReviewLog {
  id         String   @id @default(cuid())
  mistakeId  String
  studentId  String
  action     String   // reviewed | addToReviewList | removeFromReviewList | srsReview
  outcome    String?  // correct | incorrect | skipped
  reviewedAt DateTime @default(now())

  @@index([mistakeId])
  @@index([studentId])
}

// ============================================
// 十五、聆聽練習記錄
// ============================================

model ListeningSession {
  id             String    @id @default(cuid())
  studentId      String
  student        User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title          String
  audioUrl       String?
  totalQuestions Int
  correctCount   Int       @default(0)
  noteTaking     String?   // 學生筆記
  source         String    @default("ai-generated") // ai-generated | past-paper | assignment
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  answers        ListeningAnswer[]
}

model ListeningAnswer {
  id             String    @id @default(cuid())
  sessionId      String
  session        ListeningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionIndex  Int
  questionPrompt String
  correctAnswer  String
  studentAnswer  String
  isCorrect      Boolean
  timeSpent      Int?
  createdAt      DateTime  @default(now())

  @@index([sessionId])
}

// ============================================
// 十六、串字練習記錄 (Spelling Practice)
// ============================================

model SpellingSession {
  id             String    @id @default(cuid())
  studentId      String
  student        User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  totalWords     Int
  correctCount   Int       @default(0)
  status         String    @default("in-progress") // in-progress | completed
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  attempts       SpellingAttempt[]

  @@index([studentId])
}

model SpellingAttempt {
  id             String    @id @default(cuid())
  sessionId      String
  session        SpellingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  vocabId        String?
  word           String
  meaningZh      String
  explanationEn  String?   // 英文解釋提示
  studentInput   String    // 學生輸入
  isCorrect      Boolean
  attempts       Int       @default(1)  // 第幾次嘗試
  createdAt      DateTime  @default(now())

  @@index([sessionId])
  @@index([vocabId])
}
