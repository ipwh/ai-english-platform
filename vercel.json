{
  "functions": {
    "src/app/api/ai/**/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/reading/**/*.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "src/app/api/writing/**/*.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "src/app/api/speaking/**/*.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "src/app/api/vocabulary/**/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/import/**/*.ts": {
      "maxDuration": 30
    },
    "src/app/api/admin/sync-sheets/**/*.ts": {
      "maxDuration": 30
    },
    "src/app/api/admin/export-sheets/**/*.ts": {
      "maxDuration": 30
    },
    "src/app/api/admin/fix-classes/**/*.ts": {
      "maxDuration": 30
    },
    "src/app/api/ocr/**/*.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "src/app/api/export/**/*.ts": {
      "maxDuration": 30
    },
    "src/app/api/rag/**/*.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://ai-english-platform-jet.vercel.app" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,PATCH,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type,Authorization" }
      ]
    }
  ]
}
