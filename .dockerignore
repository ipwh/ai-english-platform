# Dependencies
node_modules/

# Build output
.next/
out/

# Testing
test-results/
coverage/
playwright-report/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Environment
.env
.env.*
!.env.example

# Secrets — NEVER bake into the image (inject via Cloud Run env vars)
cloud-run-env.yaml
cloud-run-env*.yaml
materials/client_secret_*.json
materials/gcp-service-account.json

# Large materials not needed at runtime (RAG serves chunks from the DB)
materials/*.pdf
materials/**/*.pdf
materials/_extracted/
materials/_hkeaa_descriptors/

# Git
.git/
.gitignore
.gitattributes

# Documentation
docs/
*.md
!README.md

# Scripts (not needed in production)
scripts/
e2e/

# Misc
*.log
npm-debug.log*
