# ============================================
# AI English Platform — 環境變數設定
# 複製此檔案為 .env.local 並填入實際值
# ============================================

# DeepSeek API (必填)
# 取得 API Key: https://platform.deepseek.com/api_keys
# 模型: deepseek-v4-flash (預設) | deepseek-v4-pro (即將推出)
# 注意: deepseek-chat / deepseek-reasoner 已於 2026-07-24 停用
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# ============================================
# Gemini API (選填 — DeepSeek 不可用時的備用 AI)
# 取得方式: https://console.cloud.google.com/apis/credentials → API 金鑰
# 金鑰類型: AQ.*（GCP API Key）或 AIza.*（AI Studio key）
# 備註: DeepSeek 失敗時會依序嘗試 Vertex Gemini → Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash

# ============================================
# Vertex Gemini (選填 — GCP Vertex AI 上的 Gemini)
# 需設定 GCP_PROJECT_ID + 任一 service account 憑證來源
GCP_PROJECT_ID=your-gcp-project-id
VERTEX_AI_LOCATION=global
VERTEX_GEMINI_MODEL=gemini-2.5-flash
# Embeddings location (usually same as VERTEX_AI_LOCATION)
# VERTEX_AI_EMBEDDINGS_LOCATION=us-central1
# 憑證來源 (三選一):
# 1. GOOGLE_APPLICATION_CREDENTIALS 指向 JSON 檔案路徑
# GOOGLE_APPLICATION_CREDENTIALS="./materials/gcp-service-account.json"
# 2. 或將 service account JSON 放在 materials/gcp-service-account.json (自動偵測)
# 3. 或直接用 GCP_SERVICE_ACCOUNT_JSON 環境變數傳入 JSON 內容
# GCP_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# ============================================
# Claude API (選填 — Anthropic Claude，Fallback 3)
# 取得 API Key: https://console.anthropic.com/
# CLAUDE_API_KEY=sk-ant-your-claude-api-key
# CLAUDE_MODEL=claude-sonnet-4-20250514

# ============================================
# OpenAI API (選填 — Fallback 4，最後備援)
# 取得 API Key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4o

# ============================================

# Google OAuth (必填 — 用於 Google 帳號登入)
# 取得方式: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-your-google-client-secret

# NextAuth (必填 — 加密 session 用)
# 產生方式: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-string

# NextAuth 應用網址（生產環境必填）
# 本地: http://localhost:3000
# Vercel: https://your-app.vercel.app
AUTH_URL=http://localhost:3000

# 資料庫 (Prisma)
# 開發環境使用 SQLite，生產環境使用 PostgreSQL
# SQLite:  file:./prisma/dev.db（本地）
# PostgreSQL: postgresql://user:pass@host:5432/dbname
# Google Cloud SQL: postgresql://user:pass@/dbname?host=/cloudsql/INSTANCE_CONNECTION_NAME
DATABASE_URL="file:./dev.db"

# JWT 認證 (生產環境請更換為隨機字串)
# 產生方式: openssl rand -base64 32
JWT_SECRET=dev-secret-change-in-production

# 應用程式網址
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === DSE RAG 歷屆試題檢索 ===
# 設為 true 以啟用 DSE 歷屆試題檢索增強生成（RAG）
# AI 出題/批改/建議時會自動引用 DSE past paper 相關內容
# 需先透過「教材中心」匯入 DSE 試題 PDF
DSE_RAG_ENABLED=true

# === AI 效能與監控 ===
# AI API 呼叫 timeout (毫秒)，開發預設 30000，生產預設 8000 (Vercel Hobby)
# AI_TIMEOUT_MS=30000

# AI 回應快取（預設 true，降低 API 費用）
# AI_CACHE_ENABLED=true
# AI_CACHE_TTL_MS=3600000

# 日誌等級：trace | debug | info | warn | error | fatal
# LOG_LEVEL=debug

# AI API 每 IP 每分鐘最大請求數（預設 60）
# AI_RATE_LIMIT_MAX=60

# === Vercel KV (分散式限流與快取) ===
# 未設定時 fallback 到 in-memory（適合單實例/低流量）
# 取得方式: Vercel Dashboard → Storage → KV
# VERCEL_KV_URL=https://your-project.kv.vercel-storage.com
# VERCEL_KV_TOKEN=your-kv-token

# === 管理員功能 ===
# Google Sheets 班級名單 ID（用於同步學生班別）
# GOOGLE_SHEETS_ID=your-google-sheets-spreadsheet-id

# Google Drive 教材資料夾 ID
# GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# Cron Job 驗證密鑰（生產環境必須設定）
# CRON_SECRET=your-cron-secret

# 管理員初始密碼（首次設定）
# ADMIN_INIT_PASSWORD=your-admin-password
