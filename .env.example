# ============================================
# AI English Platform — 環境變數設定
# 複製此檔案為 .env.local 並填入實際值
# ============================================

# DeepSeek API (必填)
# 取得 API Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ============================================
# Gemini API (選填 — DeepSeek 不可用時的備用 AI)
# 取得方式: https://console.cloud.google.com/apis/credentials → API 金鑰
# 金鑰類型: AQ.*（GCP API Key）或 AIza.*（AI Studio key）
# 備註: DeepSeek 失敗時會依序嘗試 Vertex Gemini → Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash

# ============================================
# Vertex Gemini (選填 — GCP Vertex AI 上的 Gemini)
# 需設定 GCP_PROJECT_ID + 任一 service account 憑證來源
GCP_PROJECT_ID=your-gcp-project-id
VERTEX_AI_LOCATION=global
# 憑證來源 (三選一):
# 1. GOOGLE_APPLICATION_CREDENTIALS 指向 JSON 檔案路徑
# GOOGLE_APPLICATION_CREDENTIALS="./materials/gcp-service-account.json"
# 2. 或將 service account JSON 放在 materials/gcp-service-account.json (自動偵測)
# 3. 或直接用 GCP_SERVICE_ACCOUNT_JSON 環境變數傳入 JSON 內容
# GCP_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# Google OAuth (必填 — 用於 Google 帳號登入)
# 取得方式: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-your-google-client-secret

# NextAuth (必填 — 加密 session 用)
# 產生方式: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-string

# NextAuth 應用網址（生產環境必填）
# 本地: http://localhost:3000
# Vercel: https://your-app.vercel.app
AUTH_URL=http://localhost:3000

# 資料庫 (Prisma)
# 開發環境使用 SQLite，生產環境使用 PostgreSQL
# SQLite:  file:./prisma/dev.db（本地）
# PostgreSQL: postgresql://user:pass@host:5432/dbname
# Google Cloud SQL: postgresql://user:pass@/dbname?host=/cloudsql/INSTANCE_CONNECTION_NAME
DATABASE_URL="file:./dev.db"

# JWT 認證 (生產環境請更換為隨機字串)
# 產生方式: openssl rand -base64 32
JWT_SECRET=dev-secret-change-in-production

# 應用程式網址
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === DSE RAG 歷屆試題檢索 ===
# 設為 true 以啟用 DSE 歷屆試題檢索增強生成（RAG）
# AI 出題/批改/建議時會自動引用 DSE past paper 相關內容
# 需先透過「教材中心」匯入 DSE 試題 PDF
DSE_RAG_ENABLED=true
