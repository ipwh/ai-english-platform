# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# env files (contains secrets)
.env
.env.local
.env*.local

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sensitive credentials
*client_secret_*.json
*gcp-service-account*.json
materials/_extracted/

# Cloud Run env file contains real secrets — LOCAL ONLY, never commit
# (was previously tracked; if it ever reached GitHub, rotate ALL keys)
cloud-run-env.yaml
cloud-run-env*.yaml

# Large PDF materials (too big for GitHub)
materials/*.pdf
materials/**/*.pdf

# Downloaded HKDSE reference materials (copyrighted)
materials/_hkeaa_descriptors/

# Database files
*.db
*.db-journal

# Build output
next-output.log
neon.txt
.vercel
.env*

test-results/
playwright-report/
